# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Convex (populated automatically by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_SITE_URL=your_convex_site_url

# App origin used by better-auth on the backend (also the trusted origin)
SITE_URL=http://localhost:3000

# Root domain for the CMS + tenant subdomains ({slug}.{APP_DOMAIN})
# In production point this at your apex domain, e.g. w-ai.online
NEXT_PUBLIC_APP_DOMAIN=w-ai.online

# Convex runtime: comma-separated W-AI-owned zones that tenants cannot claim.
# Set this on each Convex deployment with `npx convex env set` as well.
PLATFORM_RESERVED_DOMAINS=w-ai.online,qentrah.com

# Canonical app URL (used for absolute links, sitemaps, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain routing (set these in the Convex deployment environment, not in the browser)
DOMAIN_CNAME_TARGET=cname.vercel-dns.com
DOMAIN_APEX_TARGET=76.76.21.21
DNS_CREDENTIAL_ENCRYPTION_KEY=generate-a-random-32-byte-secret
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id
VERCEL_TOKEN=your_scoped_vercel_token
